# =============================================================================
# The Local Minima — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your own keys:
#   cp backend/.env.example backend/.env
#
# NEWSAPI_KEY (Required)
#   Register for a free developer key at https://newsapi.org
#   The free tier supports up to 100 requests/day.
NEWSAPI_KEY=your_newsapi_key_here

# GEMINI_API_KEY (Optional — enables AI-powered cluster summaries)
#   Get a free key at https://aistudio.google.com (no credit card required).
#   Free tier: 20 requests/day on gemini-2.5-flash.
#   If omitted, the system falls back to a local distilgpt2 summarizer.
GEMINI_API_KEY=your_gemini_api_key_here

# SENTIMENT_MODEL (Optional)
#   Defaults to a 3-way sentiment model with positive/neutral/negative outputs.
#   Swap this if you want to test another Hugging Face sentiment model.
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest

# SENTIMENT_STRONG_THRESHOLD (Optional)
#   Polarity threshold for Positive/Negative vs Slightly Positive/Slightly Negative.
#   Lower values make the classifier more decisive; higher values make it more cautious.
SENTIMENT_STRONG_THRESHOLD=0.25
